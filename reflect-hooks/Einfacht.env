# Einfacht.env —— OpenModelica-Full-Wasm 事实系统配置（本仓口径）。
# 由 reflect-hooks/einfacht-env.sh 加载；钩子语境里这是旋钮的唯一可复现来源。
export REFLECT_FACTS="build/FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,AGENTS.md,README.md,README.zh.md,README.de.md,CONTEXT.md"
export REFLECT_READMES="README.md,README.zh.md,README.de.md"
export REFLECT_HISTORY_SECS="5,9,10"
export REFLECT_RETRACTIONS="build/retractions.json"
export REFLECT_QUESTIONS=".scratch/open-questions/issues"
export REFLECT_MEASURE_MODULE="measure_openmodelica"

# ⚠️ 行尾**不能写 `#` 注释**（姊妹仓 2026-10-10 实测踩到）：`export X="v"  # 注释` 里的文字
#    会被**并进值里**（sh 只在**单词开头**才把 `#` 当注释）⇒ 闸门拿着带注释尾巴的路径去找文件
#    ⇒ 报"不存在"。注释只能单独成行。

# ⚠️ 「配置了就必须存在」族的旋钮（REFLECT_LOCKS / REFLECT_PINS / REFLECT_INSTRUMENTS /
#    REFLECT_DOCTOR）**故意不在这里全局配**：全局配 ⇒ gates-selftest 的**跨仓库夹具**
#    （临时目录，没有那些文件）里 FATAL ⇒ 误报「名字写死在代码里」（姊妹仓实测）。
#    ⇒ 一律**内联**传给需要它的那次调用（见 reflect-hooks/pre-commit）。

# ⚠️ `REFLECT_PINS` 也**故意不配**（姊妹仓 2026-10-10 实测裁决）：上游通用
#    `check_pins.py` 的 schema（`worktree`）与本仓 `build/upstream-pins.json` 的 schema
#    （`submodule_path` + `container_path`）**不同源** ⇒ 指错了通用闸门报
#    `KeyError: 'worktree'`。本仓的 pin 见证由 `.githooks/witness-upstream-pin.py` 承担。

# ⚠️ `REFLECT_MEASURE_MODULE` 是本仓对上游的**一处改进**（姊妹仓把数据层模块名写死成
#    `measure_octave`）：改成可配 ⇒ 「换仓库只换一个文件」这条 Einfacht 承诺才真成立。
#    见 docs/EINFACHT-INTEGRATION.md §1。
